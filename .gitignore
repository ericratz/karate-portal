.env
node_modules/
# Vite build output — rebuilt from frontend/ (npm run build)
portal/parent/dist/
tests/report/
test-results/
tests/results/
# Visual-review captures — regenerated on demand, never reviewed in git
tests/visual/shots/
tests/.db-snapshot.sql
tests/.test-status.json
tests/credentials.js
tests/.auth/
memory/
*.txt
tests/clear_rate_limit.php
tests/cleanup.config.js
# Deploy-time assets, deliberately NOT tracked: signature.png is a real
# handwritten signature — publishing it would let anyone paste it onto any
# document, and unlike a password it cannot be rotated — and the certificate
# template is a 4 MB binary that git would store in full on every change. The
# brand font that used to live here is now tracked once, at portal/assets/fonts/.
portal/admin/assets/
portal/vendor/
portal/.phpunit.result.cache
portal/.psalm-cache/
portal/composer.phar
portal/composer-setup.php
migrations/
# portal/cron/*.php IS tracked — it is application code, and it used to live in
# exactly one place with no history. Only the setup notes stay out: they name the
# host, the account path and the backup schedule.
portal/cron/CRON_SETUP.txt
backups/
# ZAP scan artifacts (keep zap-baseline.conf tracked)
docker/zap/zap.yaml
docker/zap/*.html
docker/zap/*.json
